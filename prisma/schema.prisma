generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  password              String
  name                  String?
  avatarUrl             String?
  emailVerified         DateTime? // 邮箱验证时间
  defaultWorkStartTime  String    @default("09:00")
  defaultWorkEndTime    String    @default("18:00")
  defaultBreakDuration  Int       @default(15) // minutes
  defaultTaskWeight     Int       @default(5) // 1-10
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tasks                 Task[]
  schedules             Schedule[]
  linkParses            LinkParse[]
  auditLogs             AuditLog[]
  tags                  Tag[]
  ownedTeams            Team[]        @relation("TeamOwner")
  teamMemberships       TeamMember[]
  sharedTasks           SharedTask[]  @relation("TaskSharer")
}

model Task {
  id            String      @id @default(cuid())
  title         String
  description   String?
  estimatedTime Int         // minutes
  weight        Int         @default(5) // 1-10
  priority      Priority   @default(MEDIUM)
  dueDate       DateTime?
  status        TaskStatus  @default(NOT_STARTED)
  type          TaskType    @default(OTHER)
  isFixed       Boolean     @default(false)
  fixedStart    DateTime?   // if fixed, when it starts
  fixedEnd      DateTime?   // if fixed, when it ends
  sourceUrl     String?
  parentId      String?
  isRecurring   Boolean     @default(false)
  recurrenceRule String?   // iCal RRULE format
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  userId        String
  parent        Task?       @relation("TaskHierarchy", fields: [parentId], references: [id])
  children      Task[]      @relation("TaskHierarchy")
  scheduleItems ScheduleItem[]
  sharedTasks   SharedTask[] @relation("SharedTaskTask")
  tags          Tag[]       @relation("TaskTags")

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model Tag {
  id          String      @id @default(cuid())
  name        String
  color       String      @default("#3b82f6") // 默认蓝色
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  userId      String
  tasks       Task[]      @relation("TaskTags")

  @@unique([userId, name])
  @@index([userId])
}

model Team {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner       User        @relation("TeamOwner", fields: [ownerId], references: [id])
  ownerId     String
  members     TeamMember[]
  sharedTasks SharedTask[]

  @@index([ownerId])
}

model TeamMember {
  id          String      @id @default(cuid())
  role        TeamRole    @default(MEMBER)
  joinedAt    DateTime    @default(now())

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  user        User        @relation(fields: [userId], references: [id])
  userId      String

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model SharedTask {
  id          String      @id @default(cuid())
  permission  Permission  @default(VIEW)
  sharedAt    DateTime    @default(now())

  task        Task        @relation("SharedTaskTask", fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  sharedBy    User        @relation("TaskSharer", fields: [sharedById], references: [id])
  sharedById  String

  @@unique([taskId, teamId])
  @@index([taskId])
  @@index([teamId])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum Permission {
  VIEW
  EDIT
  ADMIN
}

model Schedule {
  id          String      @id @default(cuid())
  date        DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  userId      String
  items       ScheduleItem[]

  @@unique([userId, date])
  @@index([userId])
}

model ScheduleItem {
  id          String      @id @default(cuid())
  startTime   DateTime
  endTime     DateTime
  isBreak     Boolean     @default(false)
  order       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  schedule    Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId  String
  task        Task?       @relation(fields: [taskId], references: [id])
  taskId      String?

  @@index([scheduleId])
  @@index([taskId])
}

model LinkParse {
  id          String      @id @default(cuid())
  url         String
  title       String?
  description String?
  image       String?
  favicon     String?
  parsedAt    DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  userId      String

  @@index([userId])
}

model AuditLog {
  id          String      @id @default(cuid())
  action      String      // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entity      String      // task, schedule, user, etc.
  entityId    String?
  details     Json?       // 额外的详细信息
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id])
  userId      String

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model PasswordResetToken {
  id          String      @id @default(cuid())
  token       String      @unique
  email       String
  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([token])
  @@index([email])
}

model EmailVerificationToken {
  id          String      @id @default(cuid())
  token       String      @unique
  email       String
  expiresAt   DateTime
  used        Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([token])
  @@index([email])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskType {
  WORK
  STUDY
  PERSONAL
  HEALTH
  OTHER
}
