# PlanManage 环境变量配置
# 复制此文件为 .env.local 并填入实际值

# ===========================================
# 必需配置
# ===========================================

# 数据库连接字符串
# PostgreSQL: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:password@localhost:5432/plan_manage

# NextAuth 密钥（用于加密 session）
# 生成方式: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# NextAuth URL（生产环境填入实际域名）
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# 可选配置
# ===========================================

# Supabase 配置（如果使用 Supabase）
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Node 环境（development | production | test）
NODE_ENV=development

# ===========================================
# 邮件服务配置（待实现）
# ===========================================

# SMTP 配置
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password

# 邮件发件人
# EMAIL_FROM=noreply@example.com

# ===========================================
# 文件存储配置（待实现）
# ===========================================

# 本地存储路径
# UPLOAD_DIR=./uploads

# S3 配置（如果使用 S3）
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_bucket_name

# ===========================================
# 第三方服务配置（待实现）
# ===========================================

# OpenAI API（如果使用 AI 功能）
# OPENAI_API_KEY=your_openai_api_key

# Google Analytics
# NEXT_PUBLIC_GA_ID=your_ga_id
